import { getStore } from '@netlify/blobs';
const auth=(req:Request)=>{const s=(Netlify.env.get('ADMIN_SECRET')||'').trim();return Boolean(s)&&req.headers.get('x-admin-secret')===s};
const defaults={store_name:'Hot Dog Wippel',open_days:[2,3,4,5,6,0],open_time:'18:30',close_time:'23:59',delivery_eta_min:45,delivery_eta_max:60,pix_key:'',city:'Itajaí',accepting_orders:true,zones:[['Murta',5],['Cordeiros',5],['Costa Cavalcante',5],['São Vicente',7],['Nilo Bittencourt',7],['Cidade Nova',9],['Portal 1 e 2',8],['Barra do Rio',6],['São João',7]].map(([neighborhood,fee])=>({neighborhood,fee}))};
export default async(req:Request)=>{if(!auth(req))return Response.json({error:'Acesso não autorizado.'},{status:401});const store=getStore('wippel-admin',{consistency:'strong'});if(req.method==='GET'){const saved:any=await store.get('store-settings',{type:'json'});return Response.json({settings:{...defaults,...(saved||{})}},{headers:{'cache-control':'no-store'}})}if(req.method==='PUT'){let b:any;try{b=await req.json()}catch{return Response.json({error:'Dados inválidos.'},{status:400})}const zones=Array.isArray(b.zones)?b.zones.filter((z:any)=>z&&String(z.neighborhood||'').trim()).map((z:any)=>({neighborhood:String(z.neighborhood).trim(),fee:Math.max(0,Number(z.fee)||0)})):defaults.zones;const settings={store_name:String(b.store_name||defaults.store_name).trim(),open_days:Array.isArray(b.open_days)?b.open_days.map(Number).filter((n:number)=>n>=0&&n<=6):defaults.open_days,open_time:/^\d{2}:\d{2}$/.test(String(b.open_time))?b.open_time:defaults.open_time,close_time:/^\d{2}:\d{2}$/.test(String(b.close_time))?b.close_time:defaults.close_time,delivery_eta_min:Math.max(0,Number(b.delivery_eta_min)||defaults.delivery_eta_min),delivery_eta_max:Math.max(0,Number(b.delivery_eta_max)||defaults.delivery_eta_max),pix_key:String(b.pix_key||'').trim(),city:String(b.city||defaults.city).trim(),accepting_orders:Boolean(b.accepting_orders),zones};await store.setJSON('store-settings',settings);return Response.json({ok:true,settings})}return new Response('Method not allowed',{status:405})};
export const config={path:'/api/admin-settings'};