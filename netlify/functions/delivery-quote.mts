import { getStore } from '@netlify/blobs';
const fallback=[['Murta',5],['Cordeiros',5],['Costa Cavalcante',5],['São Vicente',7],['Nilo Bittencourt',7],['Cidade Nova',9],['Portal 1 e 2',8],['Barra do Rio',6],['São João',7]].map(([neighborhood,fee])=>({neighborhood,fee}));
const norm=(s:any)=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
export default async(req:Request)=>{const u=new URL(req.url),cep=(u.searchParams.get('cep')||'').replace(/\D/g,'');if(cep.length!==8)return Response.json({error:'CEP inválido.'},{status:400});try{const v:any=await fetch('https://viacep.com.br/ws/'+cep+'/json/').then(r=>r.json());if(v.erro)return Response.json({error:'CEP não encontrado.'},{status:404});const store=getStore('wippel-admin',{consistency:'strong'});const saved:any=await store.get('store-settings',{type:'json'});const city=String(saved?.city||'Itajaí');if(norm(v.localidade)!==norm(city))return Response.json({error:`No momento entregamos somente em ${city}.`},{status:400});const zones=Array.isArray(saved?.zones)&&saved.zones.length?saved.zones:fallback;const found=zones.find((z:any)=>norm(z.neighborhood)===norm(v.bairro));const fee=found===undefined?undefined:Number(found.fee)||0;return Response.json({street:v.logradouro||'',neighborhood:v.bairro||'',city:v.localidade||city,covered:found!==undefined,delivery_fee:found!==undefined?fee:null});}catch{return Response.json({error:'Não foi possível consultar o CEP.'},{status:502})}};
export const config={path:'/api/delivery-quote'};