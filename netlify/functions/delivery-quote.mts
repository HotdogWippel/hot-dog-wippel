const fees={'murta':5,'cordeiros':5,'costa cavalcante':5,'sao vicente':7,'nilo bittencourt':7,'cidade nova':9,'portal 1 e 2':8,'barra do rio':6,'sao joao':7}; const norm=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim(); export default async(req)=>{const u=new URL(req.url),cep=(u.searchParams.get('cep')||'').replace(/\D/g,'');if(cep.length!==8)return Response.json({error:'CEP inválido.'},{status:400});try{const v=await fetch('https://viacep.com.br/ws/'+cep+'/json/').then(r=>r.json());if(v.erro)return Response.json({error:'CEP não encontrado.'},{status:404});if(norm(v.localidade)!=='itajai')return Response.json({error:'No momento entregamos somente em Itajaí.'},{status:400});const fee=fees[norm(v.bairro)];return Response.json({street:v.logradouro||'',neighborhood:v.bairro||'',city:v.localidade||'Itajaí',covered:fee!==undefined,delivery_fee:fee??null});}catch{return Response.json({error:'Não foi possível consultar o CEP.'},{status:502})}}; export const config={path:'/api/delivery-quote'};