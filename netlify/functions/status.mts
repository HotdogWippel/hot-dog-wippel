import { getStore } from '@netlify/blobs';
const defaults={open_days:[2,3,4,5,6,0],open_time:'18:30',close_time:'23:59',delivery_eta_min:45,delivery_eta_max:60,pix_key:'',accepting_orders:true};
const mins=(s:string)=>{const [h,m]=String(s||'').split(':').map(Number);return (h||0)*60+(m||0)};
export default async()=>{const store=getStore('wippel-admin',{consistency:'strong'});const saved:any=await store.get('store-settings',{type:'json'});const s={...defaults,...(saved||{})};const now=new Date();const br=new Date(now.toLocaleString('en-US',{timeZone:'America/Sao_Paulo'}));const day=br.getDay(),m=br.getHours()*60+br.getMinutes();const open=Boolean(s.accepting_orders)&&Array.isArray(s.open_days)&&s.open_days.includes(day)&&m>=mins(s.open_time)&&m<=mins(s.close_time);return Response.json({open,hours:`${s.open_time}–${s.close_time}`,estimate:`${s.delivery_eta_min}–${s.delivery_eta_max} min`,pix_key:s.pix_key||''},{headers:{'cache-control':'no-store'}})};
